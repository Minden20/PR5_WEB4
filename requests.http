### Практична робота №5: Модульна архітектура та ін'єкція залежностей у NestJS
@baseUrl = http://localhost:3000

###############################################################################
# РІВЕНЬ 1: Feature Module (DishesModule) та SharedModule (SlugService)
###############################################################################

### 1.1 Отримання списку всіх страв (з автоматично згенерованими slug)
GET {{baseUrl}}/dishes HTTP/1.1

### 1.2 Отримання страви за ідентифікатором ID
GET {{baseUrl}}/dishes/1 HTTP/1.1

### 1.3 Отримання страви за її SLUG (робота SlugService)
GET {{baseUrl}}/dishes/slug/ukrayinskyi-borshch-iz-pampushkamy HTTP/1.1

### 1.4 Створення нової страви (SlugService автоматично згенерує slug для назви)
POST {{baseUrl}}/dishes HTTP/1.1
Content-Type: application/json

{
  "title": "Хрусткі курячі крильця BBQ",
  "price": 240,
  "weightGrams": 350,
  "calories": 610,
  "isSpicy": true
}

### 1.5 Отримання щойно створеної страви за її згенерованим slug
GET {{baseUrl}}/dishes/slug/khrustki-kuriachi-kryltsia-bbq HTTP/1.1

###############################################################################
# РІВЕНЬ 2: Міжмодульна взаємодія (OrdersModule -> DishesModule)
#           та Custom Providers (STORE_CONFIG useValue, FEE_CALCULATOR useFactory)
###############################################################################

### 2.1 Створення замовлення: успішний сценарій
# OrdersService перевіряє товар у DishesService, рахує вартість
# та застосовує FEE_CALCULATOR (5% податок від STORE_CONFIG)
POST {{baseUrl}}/orders HTTP/1.1
Content-Type: application/json

{
  "productId": "1",
  "quantity": 2
}

### 2.2 Створення ще одного замовлення (Піца Діавола)
POST {{baseUrl}}/orders HTTP/1.1
Content-Type: application/json

{
  "productId": "2",
  "quantity": 1
}

### 2.3 Отримання списку всіх оформлених замовлень
GET {{baseUrl}}/orders HTTP/1.1

### 2.4 Спроба замовлення неіснуючого товару (очікується 404 Not Found)
POST {{baseUrl}}/orders HTTP/1.1
Content-Type: application/json

{
  "productId": "non-existent-dish-9999",
  "quantity": 1
}

### 2.5 Спроба замовлення з некоректною кількістю (очікується 400 Bad Request)
POST {{baseUrl}}/orders HTTP/1.1
Content-Type: application/json

{
  "productId": "1",
  "quantity": 0
}
